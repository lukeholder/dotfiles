# Local bin
export PATH="$HOME/.local/bin:$PATH"

# Homebrew (managed by chezmoi)
{{ if eq .chezmoi.arch "arm64" -}}
eval "$(/opt/homebrew/bin/brew shellenv)"
{{ else -}}
eval "$(/usr/local/bin/brew shellenv)"
{{ end -}}

# mise — runtime version manager
eval "$(mise activate zsh)"

# zsh completion
autoload -Uz compinit && compinit

# fzf — key bindings and fuzzy completion
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# fzf-tab — replace Tab completion menu with fzf picker (must be after compinit and fzf)
source "/opt/homebrew/opt/fzf-tab/share/fzf-tab/fzf-tab.zsh"

# eza — modern ls replacement
export EZA_ICONS_AUTO=1
alias ls='eza --group-directories-first'
alias ll='eza --long --git --header --group-directories-first'
alias la='eza --long --git --header --all --group-directories-first'
alias lt='eza --tree --level=2 --group-directories-first'

# bat — modern cat replacement
alias cat='bat'

# modern replacements
alias find='fd'
alias grep='rg'
alias vim='nvim'
alias ddt='ddev tableplus'
alias tw='gittower .'

# default editor
export EDITOR="zed --wait"
export VISUAL="zed --wait"

# starship — prompt
eval "$(starship init zsh)"

# chezmoi — push dotfile changes
function dotpush() {
  cd ~/.local/share/chezmoi && git add -A && git commit -m "${1:-update dotfiles}" && git push
}

# zoxide — smarter cd (must be at end of .zshrc)
eval "$(zoxide init zsh --cmd cd)"
