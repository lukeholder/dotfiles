# Ghostty Terminal Configuration
# https://ghostty.org/docs/config
#
# Location: ~/.config/ghostty/config
# Managed by chezmoi — edit with: chezmoi edit ~/.config/ghostty/config

# ---------------------------------------------------------------------------
# Font
# ---------------------------------------------------------------------------
font-family = "BerkeleyMono Nerd Font Mono"
font-size = 14

# ---------------------------------------------------------------------------
# Theme & Appearance
# ---------------------------------------------------------------------------
theme = "Catppuccin Mocha"

# Window padding (pixels)
window-padding-x = 12
window-padding-y = 10

# Keep the window background slightly transparent
background-opacity = 0.95

# Use native macOS tabs
# Requires ghostty@tip: macOS 27 tabs-titlebar frame bug (fixed by PR #13069,
# merged 2026-06-22) hasn't landed in stable yet. See
# https://github.com/ghostty-org/ghostty/issues/13070
macos-titlebar-style = "tabs"

# App icon
macos-icon = xray

# ---------------------------------------------------------------------------
# Shell
# ---------------------------------------------------------------------------
shell-integration = "zsh"

# ---------------------------------------------------------------------------
# Cursor
# ---------------------------------------------------------------------------
cursor-style = "bar"
cursor-style-blink = true

# ---------------------------------------------------------------------------
# Key Bindings
# ---------------------------------------------------------------------------
# Split pane horizontally
keybind = cmd+d=new_split:right

# Split pane vertically
keybind = cmd+shift+d=new_split:down

# Navigate splits
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down
